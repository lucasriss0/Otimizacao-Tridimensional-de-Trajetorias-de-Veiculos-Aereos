*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.json text eol=lf
requirements.txt text eol=lf

# Preserva os bytes dos registros históricos, inclusive seus hashes SHA-256.
docs/resultados/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/RESULTADOS*.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/PROTOTIPO_ENERGIA_*.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Espaços nos paths SVG são produzidos pelo Matplotlib e integram os hashes.
docs/resultados/**/*.svg -whitespace
